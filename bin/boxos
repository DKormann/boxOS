#!/usr/bin/env bun
import { mkdir, readFile, readdir, writeFile, chmod } from "node:fs/promises";
import { dirname, resolve } from "node:path";

const VERSION = "0.3.0";
const API = `/${VERSION}`;
const encoder = new TextEncoder();
const args = process.argv.slice(2);
const baseUrl = takeOption("--url") || process.env.BOXOS_URL || "http://localhost:3000";
const configDir = process.env.BOXOS_CONFIG_DIR || `${process.env.HOME}/.config/boxos`;
const accountsDir = `${configDir}/accounts`;

function help(code = 0) {
  console.log(`BOXOS ${VERSION} command line client

Usage:
  boxos account create --name NAME
  boxos account list
  boxos account show [NAME]
  boxos account use NAME
  boxos account import --name NAME FILE|-
  boxos account export [NAME]
  boxos deploy page FILE|-
  boxos deploy app MANIFEST
  boxos invoke BOX METHOD [--input JSON|@FILE] [--fuel NUMBER]
  boxos grant sign --subject PUBLIC_KEY --permission STRING [--account NAME]
  boxos grant sign --message JSON|@FILE [--account NAME]

Global options:
  --url URL       BOXOS server (default: BOXOS_URL or http://localhost:3000)
  --help          Show this help

Environment:
  BOXOS_CONFIG_DIR  Override ~/.config/boxos
  BOXOS_URL         Default server URL

Resources:
  AGENTS.md
  docs/cli.md
  docs/architecture/protocol.md
`);
  process.exit(code);
}

function takeOption(name) {
  const index = args.indexOf(name);
  if (index < 0) return undefined;
  if (index + 1 >= args.length) fail("invalid_option", `${name} requires a value`);
  return args.splice(index, 2)[1];
}
function hasFlag(name) { const i = args.indexOf(name); if (i < 0) return false; args.splice(i, 1); return true; }
function output(value) { process.stdout.write(`${JSON.stringify(value, null, 2)}\n`); }
function fail(code, message, details) { output({ error: { code, message, ...(details === undefined ? {} : { details }) } }); process.exit(1); }
function b64url(bytes) { let text = ""; for (const byte of new Uint8Array(bytes)) text += String.fromCharCode(byte); return btoa(text).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""); }
function domain(name, body) { const prefix = encoder.encode(`BOXOS:${name}:${VERSION}\0`), result = new Uint8Array(prefix.length + body.length); result.set(prefix); result.set(body, prefix.length); return result; }
async function stdin() { return await new Response(Bun.stdin.stream()).arrayBuffer(); }
async function bytesFrom(path) { return path === "-" ? new Uint8Array(await stdin()) : new Uint8Array(await readFile(path)); }
async function textArgument(value) { if (value?.startsWith("@")) return await readFile(value.slice(1), "utf8"); return value; }
async function ensureConfig() { await mkdir(accountsDir, { recursive: true, mode: 0o700 }); await chmod(configDir, 0o700).catch(() => {}); await chmod(accountsDir, 0o700).catch(() => {}); }
async function config() { try { return JSON.parse(await readFile(`${configDir}/config.json`, "utf8")); } catch { return {}; } }
async function saveConfig(value) { await ensureConfig(); await writeFile(`${configDir}/config.json`, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 }); await chmod(`${configDir}/config.json`, 0o600); }
function validName(name) { return typeof name === "string" && /^[a-zA-Z0-9_-]{1,64}$/.test(name); }
async function accountNames() { await ensureConfig(); return (await readdir(accountsDir)).filter(x => x.endsWith(".json")).map(x => x.slice(0, -5)).sort(); }
async function loadAccount(name) { const selected = name || (await config()).account; if (!validName(selected)) fail("account_required", "Select an account with `boxos account use NAME`"); try { return { name: selected, jwk: JSON.parse(await readFile(`${accountsDir}/${selected}.json`, "utf8")) }; } catch { fail("account_not_found", `Account ${selected} was not found`); } }
async function saveAccount(name, jwk) { if (!validName(name)) fail("invalid_account_name", "Account names use 1-64 letters, numbers, _ or -"); if (!jwk || jwk.kty !== "OKP" || jwk.crv !== "Ed25519" || typeof jwk.d !== "string" || typeof jwk.x !== "string") fail("invalid_private_key", "Expected an Ed25519 private JWK"); await ensureConfig(); const path = `${accountsDir}/${name}.json`; await writeFile(path, `${JSON.stringify(jwk, null, 2)}\n`, { mode: 0o600, flag: "wx" }).catch(error => { if (error.code === "EEXIST") fail("account_exists", `Account ${name} already exists`); throw error; }); await chmod(path, 0o600); return { name, publicKey: jwk.x }; }
async function request(path, init = {}) { const response = await fetch(`${baseUrl.replace(/\/$/, "")}${API}${path}`, init); const type = response.headers.get("content-type") || ""; const value = type.includes("json") ? await response.json() : new Uint8Array(await response.arrayBuffer()); if (!response.ok) fail(value?.error?.code || "http_error", value?.error?.message || `HTTP ${response.status}`, value); return value; }
async function register(publicKey) { return await request("/accounts", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ publicKey }) }); }
async function privateKey(jwk) { return await crypto.subtle.importKey("jwk", jwk, "Ed25519", false, ["sign"]); }
async function sign(jwk, name, value) { return b64url(await crypto.subtle.sign("Ed25519", await privateKey(jwk), domain(name, encoder.encode(JSON.stringify(value))))); }
async function putBlob(bytes) { return await request("/blobs", { method: "POST", body: bytes }); }
async function deployPage(path) { const blob = await putBlob(await bytesFrom(path)); const page = await request("/pages", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ blob: blob.id }) }); return { page: page.id, blob: blob.id, bytes: blob.bytes, url: page.origin, localUrl: `${new URL(baseUrl).protocol}//${page.id}.localhost${new URL(baseUrl).port ? `:${new URL(baseUrl).port}` : ""}`, fuel: page.fuel, created: page.created }; }
async function createBox(definition, directory) { const methods = {}; for (const [name, method] of Object.entries(definition.methods || {})) { if (typeof method.source !== "string") fail("invalid_manifest", `Method ${name} requires source`); const blob = await putBlob(await bytesFrom(resolve(directory, method.source))); methods[name] = { blob: blob.id }; } return await request("/boxes", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ runtime: definition.runtime || `boxos-js/${VERSION}`, instance: definition.instance, methods }) }); }

async function accountCommand(action) {
  if (action === "create") { const name = takeOption("--name"); if (!name) fail("invalid_account_name", "--name is required"); const keys = await crypto.subtle.generateKey("Ed25519", true, ["sign", "verify"]), jwk = await crypto.subtle.exportKey("jwk", keys.privateKey), saved = await saveAccount(name, jwk), registered = await register(saved.publicKey); const cfg = await config(); if (!cfg.account) { cfg.account = name; await saveConfig(cfg); } return output({ ...saved, fuel: registered.fuel, nonce: registered.nonce, active: (await config()).account === name }); }
  if (action === "list") { const cfg = await config(), names = await accountNames(); const accounts = []; for (const name of names) { const account = await loadAccount(name); accounts.push({ name, publicKey: account.jwk.x, active: cfg.account === name }); } return output({ accounts }); }
  if (action === "use") { const name = args.shift(); await loadAccount(name); const cfg = await config(); cfg.account = name; await saveConfig(cfg); return output({ account: name }); }
  if (action === "show") { const account = await loadAccount(args.shift()); const remote = await request(`/accounts/${encodeURIComponent(account.jwk.x)}`); return output({ name: account.name, ...remote }); }
  if (action === "export") { const account = await loadAccount(args.shift()); return output({ name: account.name, privateJwk: account.jwk }); }
  if (action === "import") { const name = takeOption("--name"), path = args.shift(); if (!name || !path) fail("invalid_import", "Import requires --name NAME and FILE|-"); const text = new TextDecoder().decode(await bytesFrom(path)); const parsed = JSON.parse(text), jwk = parsed.privateJwk || parsed; const saved = await saveAccount(name, jwk); await register(saved.publicKey); return output(saved); }
  help(1);
}

async function invokeCommand() { const box = args.shift(), method = args.shift(), inputText = await textArgument(takeOption("--input") || "null"), maxFuel = Number(takeOption("--fuel") || 1_000_000), accountName = takeOption("--account"), account = await loadAccount(accountName); if (!box || !method) fail("invalid_invocation", "invoke requires BOX and METHOD"); const remote = await request(`/accounts/${encodeURIComponent(account.jwk.x)}`), command = { publicKey: account.jwk.x, nonce: remote.nonce, box, method, maxFuel, input: JSON.parse(inputText) }, signature = await sign(account.jwk, "INVOKE", command); return output(await request("/invocations", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ command, signature }) })); }

if (hasFlag("--help") || args.length === 0) help();
const command = args.shift();
try {
  if (command === "account") await accountCommand(args.shift());
  else if (command === "deploy") {
    const kind = args.shift(), path = args.shift(); if (!path) fail("invalid_deploy", "deploy requires a file");
    if (kind === "page") output(await deployPage(path));
    else if (kind === "app") { const manifestPath = resolve(path), manifest = JSON.parse(await readFile(manifestPath, "utf8")), directory = dirname(manifestPath), boxes = {}; for (const [name, definition] of Object.entries(manifest.boxes || {})) boxes[name] = await createBox(definition, directory); const page = manifest.page ? await deployPage(resolve(directory, manifest.page)) : null; output({ page, boxes }); }
    else help(1);
  } else if (command === "invoke") await invokeCommand();
  else if (command === "grant" && args.shift() === "sign") { const account = await loadAccount(takeOption("--account")), messageText = await textArgument(takeOption("--message")); let grant; if (messageText) grant = JSON.parse(messageText); else { const subject = takeOption("--subject"), permission = takeOption("--permission"); if (!subject || !permission) fail("invalid_grant", "Provide --message or --subject and --permission"); grant = { domain: `boxos-grant/${VERSION}`, account: account.jwk.x, subject, permission }; } output({ account: account.jwk.x, grant, signature: await sign(account.jwk, "MESSAGE", grant) }); }
  else help(1);
} catch (error) { fail("cli_error", error instanceof Error ? error.message : String(error)); }
